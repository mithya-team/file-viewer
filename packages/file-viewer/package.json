{
  "name": "@file-viewer/react",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:artifact": "vite build && tsc -p tsconfig.build.json && node scripts/generate-tailwind-content.mjs",
    "build": "npm run build:artifact",
    "prepare": "npm run build:artifact",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify-dist": "node ./scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@embedpdf/core": "2.14.4",
    "@embedpdf/engines": "2.14.4",
    "@embedpdf/models": "2.14.4",
    "@embedpdf/pdfium": "2.14.4",
    "@embedpdf/plugin-document-manager": "2.14.4",
    "@embedpdf/plugin-render": "2.14.4",
    "@embedpdf/plugin-scroll": "2.14.4",
    "@embedpdf/plugin-search": "2.14.4",
    "@embedpdf/plugin-viewport": "2.14.4",
    "@embedpdf/plugin-zoom": "2.14.4",
    "@extend-ai/react-docx": "0.8.2",
    "@extend-ai/react-pptx": "0.1.2",
    "@extend-ai/react-xlsx": "0.16.1",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "papaparse": "5.5.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/react-test-renderer": "^19.1.0",
    "@types/papaparse": "^5.3.16",
    "happy-dom": "^17.4.4",
    "react-test-renderer": "^19.2.6",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}

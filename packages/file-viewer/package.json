{
  "name": "@file-viewer/react",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:artifact": "vite build && tsc -p tsconfig.build.json",
    "build": "npm run build:artifact",
    "prepare": "npm run build:artifact",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify-dist": "node ./scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@pagus-kit/core": "0.1.1",
    "@pagus-kit/renderer": "0.1.1",
    "docx-preview": "^0.3.6",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/react-test-renderer": "^19.1.0",
    "happy-dom": "^17.4.4",
    "react-test-renderer": "^19.2.6",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
